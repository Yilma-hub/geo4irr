# Copy this file to .env and fill in your own values.
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must stay there. This file, with empty
# values, is the one that gets committed: it tells anyone cloning the repo
# which variables exist without exposing a single one of them.
#
# Check your setup at any time with:
#
#     python -m app.check_setup


# --- Landsat, for METRIC water use (nothing to set) -------------------------
# Deliberately empty, and worth saying so. Landsat Collection 2 Level-2 is
# open, the Element 84 scene index is free and the tile service is public, so
# the satellite energy balance asks for no credentials at all. If you run your
# own TiTiler rather than leaning on the public one, point at it here:
# TITILER_URL=https://titiler.example.org


# --- Sentinel-2 through Copernicus (optional) -------------------------------
# Free account: https://dataspace.copernicus.eu
# Create an OAuth client under Sentinel Hub and use the client id and secret.
# Do NOT put your account email and password here. An OAuth client can be
# revoked on its own; your account password cannot, and if it leaks it is a way
# into the account itself.
#
# Leave these blank and satellite imagery still works, through the open AWS
# mirror, which needs no account at all.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=


# --- Delaware weather from DEOS (optional) ----------------------------------
# DEOS is a subscription web service, not an open API.
# Sign up: http://services.deos.udel.edu/ws/subscribe.php
# Without it the tool falls back to National Weather Service forecasts and
# Delaware climatology.
DEOS_WS_USER=
DEOS_WS_PASS=


# --- The evening note at 6pm (optional) -------------------------------------
# Outlook and Gmail both require an app password here rather than your normal
# password. Search your account's security settings for "app password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# --- The administrator account ----------------------------------------------
# Created the first time the server starts, and never again. The first sign-in
# asks for a new password, because whatever is written here has been written
# down somewhere to get here.
GEO4IRR_ADMIN_EMAIL=
GEO4IRR_ADMIN_PASSWORD=
